  "endings": [
    {
      "id": "ending_tea",
      "after": "scene_06",
      "title": "续茶",
      "lines": [
        { "type": "narration", "text": "第二天，雨没有停。" },
        { "type": "narration", "text": "我也没有走。" },
        { "type": "narration", "text": "我帮她擦了三天桌子。" },
        { "type": "narration", "text": "第三天的晚上她开口了。" },
        { "type": "dialog", "speaker": "她", "text": "客官。" },
        { "type": "dialog", "speaker": "无名", "text": "嗯。" },
        { "type": "dialog", "speaker": "她", "text": "客官如果不走——" },
        { "type": "dialog", "speaker": "她", "text": "那就不必再叫'客官'了。" },
        { "type": "narration", "text": "我没有说话。" },
        { "type": "narration", "text": "雨没有停。" },
        { "type": "narration", "text": "江湖的人都说雨会停。" },
        { "type": "narration", "text": "但这间客栈里的雨没有停。" },
        { "type": "narration", "text": "——完——" }
      ]
    },
    {
      "id": "ending_silent",
      "after": "scene_05",
      "title": "一碗粥",
      "lines": [
        { "type": "narration", "text": "那一夜我没睡。" },
        { "type": "narration", "text": "我听着雨听了一夜。" },
        { "type": "narration", "text": "第二天雨小了一点。" },
        { "type": "narration", "text": "我把房钱压在茶壶下面。" },
        { "type": "narration", "text": "我没有下楼。" },
        { "type": "narration", "text": "我从后窗走了。" },
        { "type": "narration", "text": "走的时候我回头看了一眼那个门缝。" },
        { "type": "narration", "text": "小油灯还在。" },
        { "type": "narration", "text": "灯下没有碗。" },
        { "type": "narration", "text": "碗被她收走了。" },
        { "type": "narration", "text": "我不知道她有没有看到我走。" },
        { "type": "narration", "text": "江湖人不问这种问题。" },
        { "type": "narration", "text": "江湖人也不回头。" },
        { "type": "narration", "text": "我回了头。" },
        { "type": "narration", "text": "——完——" }
      ]
    },
    {
      "id": "ending_rain",
      "after": "scene_04",
      "title": "雨一直下",
      "lines": [
        { "type": "narration", "text": "那一夜雨下了一整夜。" },
        { "type": "narration", "text": "我坐在窗下看了一整夜。" },
        { "type": "narration", "text": "她没有再来。" },
        { "type": "narration", "text": "掌柜也没有来收房钱。" },
        { "type": "narration", "text": "天亮的时候雨停了。" },
        { "type": "narration", "text": "我走出客栈。" },
        { "type": "narration", "text": "她站在门口。" },
        { "type": "narration", "text": "她手里端着一只空碗。" },
        { "type": "narration", "text": "她没有说话。" },
        { "type": "narration", "text": "我只是点了点头。" },
        { "type": "narration", "text": "她也只是点了点头。" },
        { "type": "narration", "text": "然后我走了。" },
        { "type": "narration", "text": "我不知道她叫什么是哪里人今年几岁。" },
        { "type": "narration", "text": "江湖人不需要知道这些。" },
        { "type": "narration", "text": "江湖人只要知道——" },
        { "type": "narration", "text": "有一年的雨夜，某一间客栈的某张桌子上，" },
        { "type": "narration", "text": "放过一只空剑鞘。" },
        { "type": "narration", "text": "——完——" }
      ]
    }
  ]
}
